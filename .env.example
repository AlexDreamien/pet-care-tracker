# Copy to .env for a local run. Nothing here is secret — there are no third-party keys.

# Where the server listens.
HOST=127.0.0.1
PORT=5174

# The origin a browser will see. WebAuthn binds every passkey to it, so a mismatch fails
# the signature check with an error that looks like a broken passkey.
PUBLIC_ORIGIN=http://localhost:5173

# SQLite file and uploaded documents. On Fly both live on the mounted volume at /data.
DATABASE_PATH=./data/pet-care-tracker.sqlite
UPLOAD_DIR=./data/uploads

# Set to the built front end to serve everything from one origin, as production does.
# Leave empty during development: `npm run web` proxies /api to this server instead.
WEB_DIST=

# Largest file an owner may upload, in bytes.
MAX_UPLOAD_BYTES=15728640

# Set this on any instance reachable from the internet. Open registration plus file
# uploads is an invitation to fill someone else's volume. Empty leaves registration open,
# which is fine on a laptop.
SIGNUP_INVITE_CODE=

# Web push. Generate a pair with:  npx web-push generate-vapid-keys
# Both empty disables push entirely, which is a supported state — the calendar subscription
# is the reminder channel that works without any of this.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Lets a scheduler with no account trigger the reminder sweep, for a machine that sleeps
# when idle and is therefore not running at nine in the morning.
PUSH_DISPATCH_SECRET=
